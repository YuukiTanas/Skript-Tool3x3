function isTillableBlock(b: block) :: boolean:
    if {_b} is not set:
        return false
    if {_b} is any of grass block, dirt, dirt path and rooted dirt:
        return true
    return false

function calcRemainingHours(expireUnix: number) :: number:
    if {_expireUnix} is not set:
        return 0
    set {_nowUnix} to unix timestamp of now
    set {_diff} to {_expireUnix} - {_nowUnix}
    if {_diff} < 0:
        set {_diff} to 0
    return round({_diff} / 3600)

function calcRemainingSeconds(expireUnix: number) :: number:
    if {_expireUnix} is not set:
        return 0
    set {_nowUnix} to unix timestamp of now
    set {_diff} to {_expireUnix} - {_nowUnix}
    if {_diff} < 0:
        set {_diff} to 0
    return {_diff}

function formatRemaining(seconds: number) :: text:
    if {_seconds} is not set:
        return "0 giây"
    if {_seconds} < 0:
        set {_seconds} to 0

    set {_days} to floor({_seconds} / 86400)
    set {_rem} to {_seconds} - ({_days} * 86400)
    set {_hours} to floor({_rem} / 3600)
    set {_rem} to {_rem} - ({_hours} * 3600)
    set {_minutes} to floor({_rem} / 60)
    set {_secs} to floor({_rem} - ({_minutes} * 60))

    if {_days} > 0:
        add "%{_days}% ngày" to {_parts::*}
    if {_hours} > 0:
        add "%{_hours}% giờ" to {_parts::*}
    if {_minutes} > 0:
        add "%{_minutes}% phút" to {_parts::*}
    if {_days} is 0:
        if {_hours} is 0:
            add "%{_secs}% giây" to {_parts::*}

    if size of {_parts::*} is 0:
        return "0 giây"
    return join {_parts::*} with " "
function lightenHex(hex: text, percent: number) :: text:
    set {_r} to fromBase((substring of {_hex} from 1 to 2), 16)
    set {_g} to fromBase((substring of {_hex} from 3 to 4), 16)
    set {_b} to fromBase((substring of {_hex} from 5 to 6), 16)
    set {_r} to round({_r} + (255 - {_r}) * {_percent} / 100)
    set {_g} to round({_g} + (255 - {_g}) * {_percent} / 100)
    set {_b} to round({_b} + (255 - {_b}) * {_percent} / 100)

    set {_rHex} to toBase({_r}, 16)
    set {_gHex} to toBase({_g}, 16)
    set {_bHex} to toBase({_b}, 16)

    if length of {_rHex} is 1:
        set {_rHex} to "0%{_rHex}%"
    if length of {_gHex} is 1:
        set {_gHex} to "0%{_gHex}%"
    if length of {_bHex} is 1:
        set {_bHex} to "0%{_bHex}%"
    return "%{_rHex}%%{_gHex}%%{_bHex}%"
on script load:
    if {3x3_id_counter} is not set:
        set {3x3_id_counter} to 0

command /tool3x3 [<text>] [<text>] [<text>] [<text>]:
    description: Đưa dụng cụ 3x3 cho người chơi đang online, làm mới lore dụng cụ, hoặc xem hướng dẫn
    usage: /tool3x3 <player|reload-lore|help> [liệu] [loại] [thời hạn]
    permission: {@permNode}
    permission message: {@prefix} {@msgOnlyOp}
    trigger:
        if arg-1 is not set:
            send "{@prefix} {@msgInvalid}"
            stop

        if arg-1 is "help":
            send "{@prefix} &6&l--- Hướng Dẫn Tool3x3 ---"
            send "{@prefix} &f/tool3x3 <player> <netherite|diamond|gold|iron|copper|stone|wood> <pickaxe|axe|shovel|hoe>[_infinity] [1m|1h|1d]"
            send "{@prefix} &7Đưa dụng cụ 3x3 cho một người chơi đang online."
            send "{@prefix} &7  liệu: netherite, diamond, gold, iron, copper, stone, wood"
            send "{@prefix} &7  loại: pickaxe, axe, shovel, hoe (thêm _infinity để được vô hạn độ bền)"
            send "{@prefix} &7  thời hạn (không bắt buộc): 1m (phút), 1h (giờ), 1d (ngày) - để trống để dụng cụ dùng vĩnh viễn"
            send "{@prefix} &f/tool3x3 reload-lore"
            send "{@prefix} &7Làm mới lore của mọi dụng cụ 3x3 mà người chơi đang online đang mang, cho khớp với nội dung lore hiện tại."
            send "{@prefix} &f/tool3x3 help"
            send "{@prefix} &7Hiện bảng hướng dẫn này."
            stop

        if arg-1 is "reload-lore":
            set {_count} to 0
            loop all players:
                loop all items in the inventory of loop-player:
                    if is3x3ToolByLore(loop-item) is true:
                        set {_lore::*} to lore of loop-item
                        if size of {_lore::*} >= 1:
                            set {_lore::1} to "{@loreTool}"
                        else:
                            add "{@loreTool}" to {_lore::*}
                        set lore of loop-item to {_lore::*}
                        add 1 to {_count}
            send "{@prefix} &aĐã làm mới lore cho &f%{_count}%&a dụng cụ."
            stop

        if arg-2 is not set:
            send "{@prefix} {@msgInvalid}"
            stop
        if arg-3 is not set:
            send "{@prefix} {@msgInvalid}"
            stop
        loop all players:
            if (name of loop-player) in lower case is (arg-1 in lower case):
                set {_target} to loop-player
        if {_target} is not set:
            send "{@prefix} {@msgInvalid}"
            stop

        set {_matRaw} to arg-2 in lower case
        set {_matName} to ""
        set {_matViet} to ""
        set {_matColor} to "FFFFFF"
        if {_matRaw} is "wood":
            set {_matName} to "wooden"
            set {_matViet} to "Gỗ"
            set {_matColor} to "8B5A2B"
        else if {_matRaw} is "stone":
            set {_matName} to "stone"
            set {_matViet} to "Đá"
            set {_matColor} to "8F8F8F"
        else if {_matRaw} is "copper":
            set {_matName} to "copper"
            set {_matViet} to "Đồng"
            set {_matColor} to "B87333"
        else if {_matRaw} is "iron":
            set {_matName} to "iron"
            set {_matViet} to "Sắt"
            set {_matColor} to "D8D8D8"
        else if {_matRaw} is "gold":
            set {_matName} to "golden"
            set {_matViet} to "Vàng"
            set {_matColor} to "FFD700"
        else if {_matRaw} is "diamond":
            set {_matName} to "diamond"
            set {_matViet} to "Kim Cương"
            set {_matColor} to "4AEDD9"
        else if {_matRaw} is "netherite":
            set {_matName} to "netherite"
            set {_matViet} to "Netherite"
            set {_matColor} to "4A4A4A"
        else:
            send "{@prefix} {@msgInvalid}"
            stop
        set {_typeRaw} to arg-3 in lower case
        set {_unbreakable} to false
        set {_tlen} to length of {_typeRaw}
        if {_tlen} > 9:
            set {_suffix} to substring of {_typeRaw} from ({_tlen} - 8) to {_tlen}
            if {_suffix} is "_infinity":
                set {_unbreakable} to true
                set {_typeRaw} to substring of {_typeRaw} from 1 to ({_tlen} - 9)

        set {_typeName} to ""
        set {_typeViet} to ""
        if {_typeRaw} is "pickaxe":
            set {_typeName} to "pickaxe"
            set {_typeViet} to "Cuốc"
        else if {_typeRaw} is "axe":
            set {_typeName} to "axe"
            set {_typeViet} to "Rìu"
        else if {_typeRaw} is "shovel":
            set {_typeName} to "shovel"
            set {_typeViet} to "Xẻng"
        else if {_typeRaw} is "hoe":
            set {_typeName} to "hoe"
            set {_typeViet} to "Lưỡi Gặt"
        else:
            send "{@prefix} {@msgInvalid}"
            stop
        set {_item} to ("%{_matName}% %{_typeName}%") parsed as item type
        if {_item} is not set:
            send "{@prefix} {@msgInvalid}"
            stop
        set {_displayNamePlain} to "%{_typeViet}% %{_matViet}% 3x3"
        set {_displayName} to "<#%{_matColor}%>&l%{_displayNamePlain}%"
        set name of {_item} to {_displayName}
        add "{@loreTool}" to lore of {_item}
        if arg-4 is set:
            set {_seconds} to parseDurationSeconds(arg-4)
            if {_seconds} < 0:
                send "{@prefix} {@msgInvalid}"
                stop
            add 1 to {3x3_id_counter}
            set {_id} to {3x3_id_counter}
            set {_duration} to {_seconds} * 1 second
            set {_expire} to now + {_duration}
            set {_expireUnix} to unix timestamp of {_expire}
            set {expire3x3::%{_id}%} to {_expireUnix}

            set {_remainText} to formatRemaining(calcRemainingSeconds({_expireUnix}))
            add "&7Hạn sử dụng: &f%{_remainText}%" to lore of {_item}
            add "&8{@idTag}:%{_id}%" to lore of {_item}
            if {_unbreakable} is true:
                set {_item} to unbreakable {_item}

            give {_item} to {_target}
            send "{@prefix} &aĐã đưa %{_displayName}%&a cho &f%{_target}%&a! &7(Còn hạn: &f%{_remainText}%&7)"
            if player is not set:
                send "{@prefix} &aBạn đã nhận %{_displayName}%&a! &7(Còn hạn: &f%{_remainText}%&7)" to {_target}
            else if player is not {_target}:
                send "{@prefix} &aBạn đã nhận %{_displayName}%&a! &7(Còn hạn: &f%{_remainText}%&7)" to {_target}
        else:
            if {_unbreakable} is true:
                set {_item} to unbreakable {_item}

            give {_item} to {_target}
            send "{@prefix} &aĐã đưa %{_displayName}%&a cho &f%{_target}%&a!"
            if player is not set:
                send "{@prefix} &aBạn đã nhận %{_displayName}%&a! &7(Vĩnh viễn)" to {_target}
            else if player is not {_target}:
                send "{@prefix} &aBạn đã nhận %{_displayName}%&a!" to {_target}
on tab complete of "/tool3x3":
    loop all players:
        add name of loop-player to {_onlineNames::*}
    add "reload-lore" to {_onlineNames::*}
    add "help" to {_onlineNames::*}
    set tab completions for position 1 to {_onlineNames::*}
    set tab completions for position 2 to "netherite", "diamond", "gold", "iron", "copper", "stone" and "wood"
    set tab completions for position 3 to "pickaxe_infinity", "axe_infinity", "shovel_infinity", "hoe_infinity", "pickaxe", "axe", "shovel" and "hoe"
on right click on air:
    set {_tool} to tool of player
    if is3x3Tool({_tool}) is true:
        if {3x3Enabled::%uuid of player%} is not set:
            set {3x3Enabled::%uuid of player%} to true
        if {3x3Enabled::%uuid of player%} is true:
            set {3x3Enabled::%uuid of player%} to false
            send action bar "{@toggleOff}" to player
        else:
            set {3x3Enabled::%uuid of player%} to true
            send action bar "{@toggleOn}" to player
        cancel event

on right click:
    if event-block is not set:
        stop
    if isTillableBlock(event-block) is false:
        stop

    set {_tool} to tool of player
    if is3x3Tool({_tool}) is false:
        stop

    if getToolCategory({_tool}) is not "hoe":
        stop

    if {3x3Enabled::%uuid of player%} is not set:
        set {3x3Enabled::%uuid of player%} to true

    if {3x3Enabled::%uuid of player%} is false:
        stop

    if event is cancelled:
        stop

    set {_id} to getExpireId({_tool})
    if {_id} > 0:
        set {_exp} to {expire3x3::%{_id}%}
        if {_exp} is set:
            set {_nowUnix} to unix timestamp of now
            if {_nowUnix} > {_exp}:
                remove {_tool} from player's inventory
                delete {expire3x3::%{_id}%}
                send "{@prefix} {@msgExpired}" to player
                stop

    set {_loc} to location of event-block

    loop numbers from -1 to 1:
        set {_i} to loop-number
        loop numbers from -1 to 1:
            set {_j} to loop-number-2

            if {_i} is 0:
                if {_j} is 0:
                    continue

            if {_tool} is not set:
                stop

            set {_target} to location of {_loc}
            add {_i} to x-coordinate of {_target}
            add {_j} to z-coordinate of {_target}

            if isTillableBlock(block at {_target}) is true:
                set block at {_target} to farmland
                draw 2 purple dust particles at {_target}

on break:
    set {_tool} to tool of player

    if is3x3Tool({_tool}) is true:

        if {3x3Enabled::%uuid of player%} is not set:
            set {3x3Enabled::%uuid of player%} to true

        if {3x3Enabled::%uuid of player%} is false:
            stop

        set {_category} to getToolCategory({_tool})

        set {_allow3x3} to false
        if {_category} is "hoe":
            if isCropBlock(event-block) is true:
                set {_allow3x3} to true
        else if {_category} is "axe":
            if isWoodBlock(event-block) is true:
                set {_allow3x3} to true
        else:
            if isJunkBlock(event-block) is false:
                set {_allow3x3} to true

        if {_allow3x3} is false:
            stop

        if event is cancelled:
            stop

        set {_foodPoints} to (player's food level) * 2
        if {_foodPoints} < 7:
            send action bar "{@msgHungry}" to player
            stop

        set {_id} to getExpireId({_tool})
        if {_id} > 0:
            set {_exp} to {expire3x3::%{_id}%}
            if {_exp} is set:
                set {_nowUnix} to unix timestamp of now
                if {_nowUnix} > {_exp}:
                    remove {_tool} from player's inventory
                    delete {expire3x3::%{_id}%}
                    send "{@prefix} {@msgExpired}" to player
                    stop

        add 1 to {veinHunger::%player%}
        if {veinHunger::%player%} >= {@veinHungerEvery}:
            set {veinHunger::%player%} to {veinHunger::%player%} - {@veinHungerEvery}
            set {_sat} to player's saturation
            if {_sat} > 0:
                if {_sat} >= 2:
                    remove 2 from player's saturation
                else:
                    set player's saturation to 0
            else:
                if player's food level > 0:
                    remove 1 from player's food level

        set {_loc} to location of event-block

        set {_mode} to "xy"

        if {_category} is "hoe":
            set {_mode} to "xz"
        else:
            set {_pitch} to player's pitch
            set {_yaw} to player's yaw

            set {_yawN} to mod({_yaw} + 360, 360)

            if {_pitch} > 45:

                set {_mode} to "xz"
            else:
                if {_pitch} < -45:
                    set {_mode} to "xz"
                else:
                    if {_yawN} < 45:
                        set {_mode} to "xy"
                    else:
                        if {_yawN} < 135:
                            set {_mode} to "zy"
                        else:
                            if {_yawN} < 225:

                                set {_mode} to "xy"
                            else:
                                if {_yawN} < 315:
                                    set {_mode} to "zy"
                                else:
                                    set {_mode} to "xy"

        loop numbers from -1 to 1:
            set {_i} to loop-number
            loop numbers from -1 to 1:
                set {_j} to loop-number-2

                if {_i} is 0:
                    if {_j} is 0:
                        continue

                if {_tool} is not set:
                    stop

                set {_target} to location of {_loc}

                if {_mode} is "xz":
                    add {_i} to x-coordinate of {_target}
                    add {_j} to z-coordinate of {_target}
                else if {_mode} is "xy":
                    add {_i} to x-coordinate of {_target}
                    add {_j} to y-coordinate of {_target}
                else:
                    add {_i} to z-coordinate of {_target}
                    add {_j} to y-coordinate of {_target}

                if block at {_target} is not air:
                    set {_blockAtTarget} to block at {_target}
                    set {_canBreak} to false
                    if {_category} is "hoe":
                        if isCropBlock({_blockAtTarget}) is true:
                            set {_canBreak} to true
                    else if {_category} is "axe":
                        if isWoodBlock({_blockAtTarget}) is true:
                            set {_canBreak} to true
                    else:
                        if isBlockBlacklisted({_blockAtTarget}) is false:
                            set {_canBreak} to true

                    if {_canBreak} is true:
                        draw 2 purple dust particles at {_target}
                        break block at {_target} naturally using {_tool}

every 5 seconds:
    loop all players:
        loop all items in the inventory of loop-player:
            if is3x3Tool(loop-item) is true:
                set {_id} to getExpireId(loop-item)
                if {_id} > 0:
                    set {_exp} to {expire3x3::%{_id}%}
                    if {_exp} is set:
                        set {_remSeconds} to calcRemainingSeconds({_exp})
                        if {_remSeconds} <= 0:
                            remove loop-item from loop-player's inventory
                            delete {expire3x3::%{_id}%}
                            send "{@prefix} {@msgExpired}" to loop-player
                        else:
                            set {_remainText} to formatRemaining({_remSeconds})
                            set {_lore::*} to lore of loop-item
                            set {_lastIdx} to size of {_lore::*}
                            set {_expIdx} to {_lastIdx} - 1
                            set {_lore::%{_expIdx}%} to "&7Hạn sử dụng: &f%{_remainText}%"
                            set lore of loop-item to {_lore::*}
