#####################################################################
#                                                                   #
#          TOOL3X3 - SKRIPT / Dev: Yuuki Tanas + noxgun             #
#                                                                   #
#####################################################################
#
# Liên hệ: https://linktr.ee/yuukitanas0611
#
# YÊU CẦU
#   - Plugin Skript
#   - Plugin SkBee
#
# ------------------------------------------------------------------
# CÁCH HOẠT ĐỘNG
# ------------------------------------------------------------------
#   - "Dụng cụ 3x3" là một tool bình thường (cuốc / rìu / xẻng /
#     lưỡi gặt) có gắn một dòng lore đặc biệt. Khi phá 1 khối bằng
#     dụng cụ này, script sẽ phá thêm 8 khối xung quanh, theo mặt
#     phẳng mà người chơi đang nhìn (lên/xuống, ngang, hoặc thẳng).
#
#   - Cuốc & Xẻng : phá 3x3 với hầu hết mọi loại khối, trừ một danh
#     sách khối "rác" được liệt kê sẵn (biển, thảm, cây trồng, cây
#     con, lá cây, hoa...) để tránh phá lan gây phiền.
#
#   - Rìu : chỉ phá 3x3 khi khối phá là khối liên quan đến gỗ (gỗ
#     tròn, ván gỗ, cầu thang, bậc thang, hàng rào, cửa, cửa sập,
#     biển gỗ, lá cây...). Phá khối khác thì chỉ phá 1 khối bình
#     thường.
#
#   - Lưỡi Gặt (Hoe) : chỉ thu hoạch 3x3 khi khối phá là cây trồng
#     (lúa mì, cà rốt, khoai tây, củ cải đường, dây leo dưa/bí,
#     cacao, việt quất, tre...). Click chuột phải bằng lưỡi gặt lên
#     đất/cỏ cũng sẽ xới thêm 8 ô đất xung quanh thành đất ruộng.
#     Phá khối khác thì chỉ phá 1 khối bình thường.
#
#   - Mỗi người chơi có thể tự bật/tắt chế độ 3x3 của riêng mình
#     bằng cách click chuột phải vào không khí khi đang cầm dụng cụ
#     3x3.
#
#   - Phá khối theo kiểu 3x3 sẽ tốn thêm độ no mỗi
#     {@veinHungerEvery} khối phá thêm, và sẽ bị chặn nếu độ no của
#     người chơi quá thấp.
#
#   - Dụng cụ 3x3 có thể có thời hạn sử dụng (tùy chọn); khi hết hạn
#     sẽ tự động bị xóa khỏi túi đồ người chơi.
#
# ------------------------------------------------------------------
# LỆNH / CÁCH SỬ DỤNG
# ------------------------------------------------------------------
#   /tool3x3 <player> <liệu> <loại> [thời hạn]
#       Đưa dụng cụ 3x3 cho một người chơi đang online.
#         player    : tên người chơi
#         liệu      : netherite | diamond | gold | iron | copper |
#                      stone | wood
#         loại      : pickaxe | axe | shovel | hoe
#                      (thêm hậu tố "_infinity" để được vô hạn độ
#                       bền, ví dụ "pickaxe_infinity")
#         thời hạn  : không bắt buộc, ví dụ 1m (phút) / 1h (giờ) /
#                      1d (ngày) - để trống nếu muốn dùng vĩnh viễn
#
#   /tool3x3 reload-lore
#       Làm mới lore của mọi dụng cụ 3x3 mà người chơi đang online
#       đang mang trong người, cho khớp với nội dung "loreTool" hiện
#       tại bên dưới. Chạy lệnh này sau khi bạn đổi nội dung option
#       đó, để những dụng cụ đã đưa ra từ trước vẫn được nhận diện
#       là dụng cụ 3x3.
#
#   /tool3x3 help
#       Hiện bảng hướng dẫn cách dùng ngay trong game.
#
#   Tất cả lệnh con trên đều cần quyền: "3x3.admin"
#   (xem option "permNode" bên dưới)
#
# ------------------------------------------------------------------
# OPTIONS TÙY CHỈNH
# ------------------------------------------------------------------
#   Mọi câu chữ, màu sắc và con số bên dưới đều có thể tự do chỉnh
#   sửa. Xem chú thích ngay phía trên từng dòng trong khối
#   "options:" bên dưới để biết dòng đó dùng để làm gì.
#
#####################################################################

options:
    # Tiền tố (prefix) hiện trước mỗi tin nhắn của script này.
    prefix: &8[&aTool3x3&8]&r

    # Dòng lore dùng để đánh dấu và nhận diện dụng cụ 3x3. Nếu đổi
    # dòng này, hãy chạy "/tool3x3 reload-lore" để cập nhật lại các
    # dụng cụ đã phát trước đó.
    loreTool: &7Dụng cụ 3x3 - Có thể đổi tên, enchant.

    # Tiền tố tag nội bộ dùng để lưu ID hạn dùng của dụng cụ vào
    # trong lore. Dùng cho nội bộ script, không cần chỉnh sửa.
    idTag: ID3X3

    # Quyền (permission) cần có để dùng bất kỳ lệnh con /tool3x3 nào.
    permNode: 3x3.admin

    # Thông báo hiện ra khi người chơi không có quyền dùng /tool3x3.
    msgOnlyOp: &4Bạn ko có quyền sử dụng lệnh này!

    # Thông báo hiện ra khi gõ lệnh/đối số sai.
    msgInvalid: &4Lệnh không hợp lệ!

    # Thông báo hiện ra cho người chơi khi dụng cụ có thời hạn vừa
    # hết hạn.
    msgExpired: &4Dụng cụ đã hết hạn!

    # Thông báo trên thanh action bar khi độ no của người chơi quá
    # thấp để tiếp tục phá khối theo kiểu 3x3.
    msgHungry: &4Bạn đang đói&f

    # Dự trù cho hiệu ứng âm thanh trong tương lai; hiện chưa dùng.
    amethystSound: block.amethyst_cluster.break
    amethystVolume: 1
    amethystPitch: 1

    # Cứ phá thêm bao nhiêu khối 3x3 thì trừ 1 điểm độ no (nửa đùi
    # gà).
    veinHungerEvery: 20

    # Text trên action bar khi người chơi bật/tắt chế độ 3x3.
    toggleOn: &a&lĐào 3x3: &fBẬT
    toggleOff: &c&lĐào 3x3: &fTẮT

#####################################################################
#                                                                   #
#                                CODE                               #
#              (phần code bên dưới, chỉnh sửa cẩn thận)             #
#                                                                   #
#####################################################################

function is3x3Tool(tool: item) :: boolean:
    if {_tool} is not set:
        return false
    if lore of {_tool} contains "{@loreTool}":
        return true
    return false

function is3x3ToolByLore(tool: item) :: boolean:
    if {_tool} is not set:
        return false
    set {_lore::*} to lore of {_tool}
    loop {_lore::*}:
        if loop-value contains "3x3":
            return true
    return false
function getExpireId(tool: item) :: number:
    if {_tool} is not set:
        return 0
    set {_last} to last element of (lore of {_tool})
    if {_last} is not set:
        return 0
    set {_prefix} to "&8{@idTag}:"
    if {_last} contains {_prefix}:
        set {_start} to (length of {_prefix}) + 1
        set {_len} to length of {_last}
        set {_num} to (substring of {_last} from {_start} to {_len}) parsed as number
        if {_num} is set:
            return {_num}
    return 0

function parseDurationSeconds(input: text) :: number:
    if {_input} is not set:
        return -1

    set {_raw} to {_input} in lower case
    set {_len} to length of {_raw}
    if {_len} < 2:
        return -1

    set {_unit} to substring of {_raw} from {_len} to {_len}
    set {_numPart} to substring of {_raw} from 1 to ({_len} - 1)
    set {_num} to {_numPart} parsed as number
    if {_num} is not set:
        return -1
    if {_num} <= 0:
        return -1

    if {_unit} is "m":
        return {_num} * 60
    else if {_unit} is "h":
        return {_num} * 3600
    else if {_unit} is "d":
        return {_num} * 86400
    else:
        return -1
function isJunkBlock(b: block) :: boolean:
    if {_b} is not set:
        return false
    if {_b} is tagged as tag "minecraft:wool_carpets":
        return true
    if {_b} is tagged as tag "minecraft:buttons":
        return true
    if {_b} is tagged as tag "minecraft:pressure_plates":
        return true
    if {_b} is tagged as tag "minecraft:logs":
        return true
    if {_b} is tagged as tag "minecraft:planks":
        return true
    if {_b} is tagged as tag "minecraft:wooden_stairs":
        return true
    if {_b} is tagged as tag "minecraft:wooden_slabs":
        return true
    if {_b} is tagged as tag "minecraft:wooden_fences":
        return true
    if {_b} is tagged as tag "minecraft:fence_gates":
        return true
    if {_b} is tagged as tag "minecraft:wooden_doors":
        return true
    if {_b} is tagged as tag "minecraft:wooden_trapdoors":
        return true
    if {_b} is tagged as tag "minecraft:signs":
        return true
    if {_b} is tagged as tag "minecraft:wall_signs":
        return true
    if {_b} is tagged as tag "minecraft:ceiling_hanging_signs":
        return true
    if {_b} is tagged as tag "minecraft:wall_hanging_signs":
        return true
    if {_b} is a shulker box:
        return true
    if {_b} is dead bush:
        return true
    if {_b} is any of bedrock, chest, trapped chest, ender chest, barrel, ancient debris, spawner, beacon, reinforced deepslate, vault, trial spawner, end portal frame, obsidian and dragon egg:
        return true
    if {_b} is any of short grass, tall grass, fern, large fern, seagrass, tall seagrass, kelp and kelp plant:
        return true
    if {_b} is any of oak leaves, spruce leaves, birch leaves, jungle leaves, acacia leaves, dark oak leaves, pale oak leaves, mangrove leaves, cherry leaves, azalea leaves and flowering azalea leaves:
        return true
    if {_b} is any of oak sapling, spruce sapling, birch sapling, jungle sapling, acacia sapling, dark oak sapling, pale oak sapling, mangrove propagule, cherry sapling, azalea and flowering azalea:
        return true
    if {_b} is any of wheat, carrots, potatoes, beetroots, nether wart, melon stem, attached melon stem, pumpkin stem, attached pumpkin stem, cocoa, sweet berry bush, bamboo, bamboo sapling, torchflower crop and pitcher crop:
        return true
    if {_b} is any of dandelion, poppy, blue orchid, allium, azure bluet, red tulip, orange tulip, white tulip, pink tulip, oxeye daisy, cornflower, lily of the valley, wither rose, sunflower, lilac, rose bush, peony and torchflower:
        return true
    if {_b} is any of leaf litter, pink petals, vine, weeping vines, weeping vines plant, twisting vines, twisting vines plant, cave vines, cave vines plant, glow lichen, hanging roots, moss carpet, sugar cane, cactus, brown mushroom, red mushroom, lily pad, sea pickle and spore blossom:
        return true
    if {_b} is any of tube coral, brain coral, bubble coral, fire coral, horn coral, tube coral fan, brain coral fan, bubble coral fan, fire coral fan, horn coral fan, dead tube coral, dead brain coral, dead bubble coral, dead fire coral, dead horn coral, dead tube coral fan, dead brain coral fan, dead bubble coral fan, dead fire coral fan and dead horn coral fan:
        return true
    if {_b} is any of open eyeblossom, closed eyeblossom, pale moss block, pale moss carpet and pale hanging moss:
        return true
    if {_b} is any of moss block, big dripleaf, big dripleaf stem and small dripleaf:
        return true
    if {_b} is any of small amethyst bud, medium amethyst bud, large amethyst bud and amethyst cluster:
        return true
    if {_b} is any of cactus flower, short dry grass, tall dry grass, bush and wildflowers:
        return true
    if {_b} is any of crimson fungus, warped fungus, crimson roots, warped roots and nether sprouts:
        return true
    if {_b} is any of cobweb, snow, lodestone, tnt, slime block and firefly bush:
        return true
    if {_b} is any of furnace, blast furnace and smoker:
        return true
    if {_b} is any of crafting table, anvil, chipped anvil, damaged anvil, enchanting table, brewing stand, cauldron, grindstone, stonecutter, loom, cartography table, smithing table, fletching table and composter:
        return true
    if {_b} is any of lectern, jukebox, note block, dispenser, dropper, hopper and crafter:
        return true

    return false

function isBlockBlacklisted(b: block) :: boolean:
    if isJunkBlock({_b}) is true:
        return true
    return false

function getToolCategory(tool: item) :: text:
    if {_tool} is not set:
        return "other"
    set {_typeText} to ("%type of {_tool}%" in lower case)
    if {_typeText} contains "pickaxe":
        return "pickaxe"
    if {_typeText} contains "shovel":
        return "shovel"
    if {_typeText} contains "hoe":
        return "hoe"
    if {_typeText} contains "axe":
        return "axe"
    return "other"

function isCropBlock(b: block) :: boolean:
    if {_b} is not set:
        return false
    if {_b} is any of wheat, carrots, potatoes, beetroots, nether wart, melon stem, attached melon stem, pumpkin stem, attached pumpkin stem, cocoa, sweet berry bush, bamboo, bamboo sapling, torchflower crop and pitcher crop:
        return true
    return false

function isWoodBlock(b: block) :: boolean:
    if {_b} is not set:
        return false
    if {_b} is tagged as tag "minecraft:logs":
        return true
    if {_b} is tagged as tag "minecraft:planks":
        return true
    if {_b} is tagged as tag "minecraft:wooden_stairs":
        return true
    if {_b} is tagged as tag "minecraft:wooden_slabs":
        return true
    if {_b} is tagged as tag "minecraft:wooden_fences":
        return true
    if {_b} is tagged as tag "minecraft:fence_gates":
        return true
    if {_b} is tagged as tag "minecraft:wooden_doors":
        return true
    if {_b} is tagged as tag "minecraft:wooden_trapdoors":
        return true
    if {_b} is tagged as tag "minecraft:wooden_buttons":
        return true
    if {_b} is tagged as tag "minecraft:wooden_pressure_plates":
        return true
    if {_b} is tagged as tag "minecraft:signs":
        return true
    if {_b} is tagged as tag "minecraft:wall_signs":
        return true
    if {_b} is tagged as tag "minecraft:ceiling_hanging_signs":
        return true
    if {_b} is tagged as tag "minecraft:wall_hanging_signs":
        return true
    if {_b} is tagged as tag "minecraft:leaves":
        return true
